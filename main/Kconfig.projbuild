menu "Service Mode (which network service runs)"

    # 顶层菜单。哪几个模式可用 + NVS 没记录时回退到哪个，由这里决定。
    # 【允许三个全不勾】此时设备只做配网 + 网页，不跑任何网络通讯服务。
    # 那种配置下，本菜单里的 "Default service mode" / "Stop timeout" 以及
    # 下面整个 "Service common" 菜单都没有意义，会自动隐藏；代码里对应的
    # 部分也不会被编译进去 —— 判据统一是下面这个 SERVICE_ANY_ENABLE。

    config SERVICE_TCP_CLIENT_ENABLE
        bool "Enable TCP client"
        default y
        help
            勾选后 TCP 客户端（主动连远程服务器）作为可选模式出现。
            取消勾选后 TCP client 在运行时永远不会被启用，
            但 tcp_client 组件的代码仍会被编译（仅作 flash 代价，
            运行期不可选）。

    config SERVICE_TCP_SERVER_ENABLE
        bool "Enable TCP server"
        default y
        help
            勾选后 TCP 服务端（监听端口接受远程客户端）作为可选模式出现。

    config SERVICE_UDP_ENABLE
        bool "Enable UDP"
        default y
        help
            勾选后 UDP（同一 socket 收发）作为可选模式出现。

    # ---- 派生开关（无 prompt，menuconfig 里看不到）----
    # 等价于"上面三个里至少勾了一个"。整套网络服务框架（收发队列 + consumer
    # 任务 + service_manager + /api/service-mode）只在它为 y 时才有存在意义：
    #   - Kconfig 里：用它隐藏下面那些"全关时没有意义"的选项；
    #   - 代码里：统一写 #if CONFIG_SERVICE_ANY_ENABLE 把整段编译掉。
    config SERVICE_ANY_ENABLE
        bool
        default y if SERVICE_TCP_CLIENT_ENABLE || SERVICE_TCP_SERVER_ENABLE || SERVICE_UDP_ENABLE

    choice SERVICE_DEFAULT_MODE
        prompt "Default service mode (used when NVS is empty or invalid)"
        # 没勾任何服务时"默认用哪个"不成立，这一项连选项一起隐藏
        depends on SERVICE_ANY_ENABLE
        default SERVICE_DEFAULT_TCP_CLIENT
        config SERVICE_DEFAULT_TCP_CLIENT
                bool "TCP Client"
                depends on SERVICE_TCP_CLIENT_ENABLE
        config SERVICE_DEFAULT_TCP_SERVER
                bool "TCP Server"
                depends on SERVICE_TCP_SERVER_ENABLE
        config SERVICE_DEFAULT_UDP
                bool "UDP"
                depends on SERVICE_UDP_ENABLE
    endchoice

    config SERVICE_SWITCH_TIMEOUT_MS
        int "Stop timeout when switching modes (ms)"
        # 没有服务运行 → 不存在"切模式"，这个超时也没有意义
        depends on SERVICE_ANY_ENABLE
        default 8000
        range 1000 60000
        help
            切换时给"正在跑的 service"留的退出时间。超时后 manager
            **不会**强制切到下一个，而是保持旧 service 继续运行、
            稍后重试 —— 两个 service 同时跑会抢 socket/端口，状态
            不可控，所以宁可切不过去也不能并发。

            这个值要大于各 service 内部最慢的"停服响应时间"，否则会
            频繁看到"在 N ms 内未退出"的告警。已知的最慢路径：
              - tcp_client：等 connect 返回，最多
                CONFIG_TCP_CLIENT_CONNECT_TIMEOUT_MS（默认 5000）
              - tcp_server：等 client handler 从 send 里返回，
                最多 SO_SNDTIMEO（5000）
            默认 8000 覆盖这两者。
endmenu

menu "Service common"
    # 三个网络服务共用的收发队列 + 单帧尺寸。
    # service_manager 保证三个 service 同一时刻只有一个在跑，所以可以
    # 共用同一对队列 + 同一个消费任务，而不需要每服务各搞一份。
    #
    # 一个服务都没勾时队列根本不会被创建（main.c 里整段编译掉），
    # 所以整个菜单跟着 SERVICE_ANY_ENABLE 一起隐藏。
    depends on SERVICE_ANY_ENABLE

config RX_MAX_FRAME
    int "Single-frame max size (bytes)"
    default 1024
    range 64 4096
    help
        【三个服务共用的"单帧最大字节"】
        同时决定：
          - tx_item_t / rx_item_t 内嵌 data 字段的尺寸（BSS 常驻 = 深度 × 本值 × 2）；
          - 各 recv task 栈上 recv buffer 的尺寸上限。

        设得太大：常驻 RAM 涨（队列深度 × 本值 × 2 ≈ 8KB@4×1024）。
        设得太小：超过的单帧会被截断（TCP）或丢（UDP）。

config TX_QUEUE_LEN
    int "Tx queue length (frames)"
    default 4
    range 1 32
    help
        【上行队列深度】
        tcp_app_send() / udp_app_send() / srv_app_send() 投递的所有上行帧
        都进这一个队列，由 tx_consumer_task 取出并按"目的地"发送。
        队列满时新帧被丢弃并打 warning。

config RX_QUEUE_LEN
    int "Rx queue length (frames)"
    default 4
    range 1 32
    help
        【下行队列深度】
        tcp_conn_task / tcp_server_client_task / udp_task 收到的数据都进
        这一个队列，由 rx_consumer_task 取出后调 tcp_app_on_recv()。
        队列满时新帧被丢弃并打 warning（不影响收包循环）。
endmenu

menu "WiFi Configuration"
    # 这套选项是 WiFi 启动时的"默认值来源"：
    #   - NVS 里若已存了 STA 凭证，则用 NVS（web 配网留下的）覆盖这里；
    #   - 没存时，wifi 组件按这里的 STA / AP 参数启动；
    #   - WIFI_MODE = AP：跳过 web 配网，开机直接作为热点；
    #   - WIFI_MODE = STA 且 STA SSID 留空：进入 web 配网。
    #
    # 两个模式对应 wifi_init_cfg_t::mode：
    #   - STA    → WIFI_MODE_STA
    #   - AP     → WIFI_MODE_AP

    choice WIFI_MODE
        prompt "WiFi mode"
        default WIFI_MODE_STA
        config WIFI_MODE_STA
            bool "STA (client only)"
        config WIFI_MODE_AP
            bool "AP (hotspot only)"
    endchoice

    # 派生：当前模式是否为 STA / AP。其它选项 depends on 这俩，
    # 把"这个菜单只属于哪种模式"集中在这里表达。
    config WIFI_HAS_STA
        bool
        default y if WIFI_MODE_STA
    config WIFI_HAS_AP
        bool
        default y if WIFI_MODE_AP

    config WIFI_STA_SSID
        string "STA SSID (要连的上游路由器)"
        default ""
        depends on WIFI_HAS_STA
        help
            留空且 NVS 也没保存 → 开机进入 web 配网。

    config WIFI_STA_PASSWORD
        string "STA password (留空 = 开放网络)"
        default ""
        depends on WIFI_HAS_STA

    config WIFI_STA_USE_DHCP
        bool "STA: 用 DHCP (取消勾选使用静态 IP)"
        default y
        depends on WIFI_HAS_STA

    config WIFI_STA_STATIC_IP
        string "STA 静态 IP (DHCP 关时生效)"
        default "192.168.1.100"
        depends on WIFI_HAS_STA && !WIFI_STA_USE_DHCP

    config WIFI_STA_STATIC_NETMASK
        string "STA 子网掩码"
        default "255.255.255.0"
        depends on WIFI_HAS_STA && !WIFI_STA_USE_DHCP

    config WIFI_STA_STATIC_GATEWAY
        string "STA 网关"
        default "192.168.1.1"
        depends on WIFI_HAS_STA && !WIFI_STA_USE_DHCP

    config WIFI_STA_DNS_MAIN
        string "STA 主 DNS (DHCP 关时生效；留空表示不设置)"
        default ""
        depends on WIFI_HAS_STA && !WIFI_STA_USE_DHCP

    config WIFI_STA_DNS_BACKUP
        string "STA 备用 DNS (DHCP 关时生效；留空表示不设置)"
        default ""
        depends on WIFI_HAS_STA && !WIFI_STA_USE_DHCP

    config WIFI_AP_SSID
        string "AP SSID (本机热点名)"
        default "roboot_mc"
        depends on WIFI_HAS_AP

    config WIFI_AP_PASSWORD
        string "AP password (留空 = 开放热点，否则 8~63 位)"
        default ""
        depends on WIFI_HAS_AP

    config WIFI_AP_MAX_CONN
        int "AP 最大连接数"
        default 4
        range 1 10
        depends on WIFI_HAS_AP

    config WIFI_AP_IP
        string "AP 模式下本机 IP (连入设备以此为网关)"
        default "192.168.4.1"
        depends on WIFI_HAS_AP
        help
            AP 启动后 ESP32 自身的 IP 地址，同时充当连入设备的网关。
            web 配置页地址即 http://<此IP>。注意不要与 STA 侧要连的上游网段冲突。
endmenu

menu "Application identity"
    # 应用层身份信息。
    #
    # 设备名称默认值这里支持两种写法：
    #   1. 纯 ASCII：直接作为设备名（如 roboot_mc）
    #   2. UTF-8 HEX 字符串：C 端运行时按 HEX 解码为 UTF-8
    # 为什么需要 HEX：Kconfiglib menuconfig 的 TUI 输入不支持非 ASCII，
    # 输入中文会被编码成 UTF-16 代理对，写回 sdkconfig 时 Python 报
    # 'utf-8 codec can't encode ... surrogates not allowed'，保存直接失败。
    # 用 HEX 后整个字符串就是合法 ASCII，menuconfig 能正常保存。
    #
    # 查 UTF-8 HEX：python3 -c "print('中文'.encode('utf-8').hex().upper())"
    #   例："我的小车" → E68891E7A59EE5B08FE8BDA6

    config DEVICE_NAME_DEFAULT
        string "默认设备名称 (HEX=中文 / 纯 ASCII=英文)"
        default "roboot_mc"
        help
            配网页「设备名称」字段的默认值。
            ASCII 直用；中文请用 UTF-8 HEX（每 2 位一个字节）。
            HEX 自动判别规则：全 [0-9A-Fa-f] 且长度为偶数 → 解码为 UTF-8；
            否则按字面量当 ASCII 用。长度上限 60 字节。

    config FW_VERSION
        string "底层 APP 版本"
        default "v1.0.0"
        help
            header 芯片「底层 APP」显示的版本号——
            即"本组件（与 main 在同一固件）所在层"的版本。
            格式建议：vMAJOR.MINOR.PATCH[-PRERELEASE][+BUILD]
            例：v1.0.0 / v1.2.3-rc.1 / v2.0.0-beta.2+20251008

    config APP_VERSION
        string "App 版本"
        default "v1.0.0"
        help
            header 芯片「App」显示的版本号——上层应用层版本。
            格式建议：vMAJOR.MINOR.PATCH[-PRERELEASE][+BUILD]。
            留空则芯片显示 —。
endmenu