menu "TCP Client"
    depends on SERVICE_TCP_CLIENT_ENABLE

    config TCP_CLIENT_HOST_STA
        string "Remote host (STA mode, e.g. 192.168.1.38)"
        default "192.168.1.38"
        help
            STA 模式下设备要连的服务器地址（IP 或主机名）。
            配网后此值仍生效 —— 想换服务器地址改这里重烧即可。

    config TCP_CLIENT_HOST_AP
        string "Remote host (AP mode, e.g. 192.168.4.1)"
        default "192.168.4.1"
        help
            AP 模式下设备要连的服务器地址。
            热点内的设备直接互通，常用 192.168.4.1 这种本侧地址。

    config TCP_CLIENT_PORT
        int "Remote port"
        default 8888
        range 1 65535

    config TCP_CLIENT_CONNECT_TIMEOUT_MS
        int "connect() hard timeout (ms)"
        default 5000
        range 500 60000
        help
            connect 的硬超时（非阻塞 connect + poll 实现）。最坏等这么久
            就返回，不受协议栈内部重传策略影响。

            注意这个值也决定了"切服务模式时 tcp_client 最多卡多久"：
            service_manager 发出停服请求后，tcp_conn_task 若正阻塞在
            connect 里，要等它返回才能检查停服标志。所以它应当 <=
            CONFIG_SERVICE_SWITCH_TIMEOUT_MS，否则会看到"tcp_client
            在 N ms 内未退出"的告警。

    config TCP_CLIENT_RECV_TIMEOUT_MS
        int "Per-recv blocking timeout (ms)"
        default 1000
        range 100 60000
        help
            只是"隔多久醒来查一次连接状态 / 停服标志"，不影响响应延迟
            ——有数据会立刻返回。所以不用给大。

    config TCP_CLIENT_RECONNECT_MS
        int "Reconnect delay after disconnect (ms)"
        default 2000
        range 100 60000

    config TCP_CLIENT_KEEPALIVE_IDLE_S
        int "TCP keepalive idle (seconds before first probe)"
        default 20
        range 0 600

    config TCP_CLIENT_KEEPALIVE_INTVL_S
        int "TCP keepalive probe interval (seconds)"
        default 5
        range 1 60

    config TCP_CLIENT_KEEPALIVE_CNT
        int "TCP keepalive probe count (failed probes to declare dead)"
        default 3
        range 1 10

    config TCP_CLIENT_HEARTBEAT_MS
        int "Idle heartbeat interval (ms), 0 to disable"
        default 10000
        range 0 3600000
        help
            应用层心跳：连接空闲超过这个时长、且期间没有任何收发流量时，
            主动发一个带 payload 的心跳帧（内容见 main.c 的
            TCP_APP_HEARTBEAT_PAYLOAD）。

            为什么不只用 TCP keepalive：keepalive 探针是"纯 ACK 包、零字节
            payload"，很多路由器/AP 的 NAT 会话表只认"带数据的包"才刷新老化
            计时 —— 表项老化后连接被中间设备静默丢弃，keepalive 反而把它
            "发现"成断线（表现为"空闲一段时间自己断开"）。带 payload 的
            心跳帧能把所有中间设备的会话表都续上。

            心跳 send 失败会被当作连接已死，立刻触发重连。0 = 关闭心跳。

    config TCP_CLIENT_SEND_SLOW_US
        int "Slow-send warn threshold (microseconds)"
        default 20000
        range 1000 1000000
        help
            send 阻塞超过这个时长打一条 warning 日志。0 表示关闭。

    config TCP_CLIENT_LOG_RX_DUMP
        bool "Log RX payload as hexdump"
        default n
endmenu