menu "UDP"
    depends on SERVICE_UDP_ENABLE

    config UDP_PORT
        int "Bind port"
        default 7777
        range 1 65535

    # 注：UDP 接收缓冲区统一使用 CONFIG_RX_MAX_FRAME（service common 菜单）。
    # UDP payload 上限取决于 MTU（不分片 1472 字节）；通过 IP 分片可更大，
    # 但风险高，所以默认 1024 已经够大多数控制指令。

    config UDP_RECV_TIMEOUT_MS
        int "recvfrom wakeup period (ms)"
        default 1000
        range 100 10000
        help
            recvfrom 阻塞超过这个时长就返回，让 worker 周期性检查
            "网络状态 / IP 是否变了"。

    config UDP_SEND_TIMEOUT_MS
        int "sendto blocking timeout (ms)"
        default 5000
        range 100 60000
endmenu
