{
  "文件头注释": {
    "scope": "c,cpp,objective-c",
    "prefix": ["fhdr", "文件头"],
    "body": [
      "/**",
      " * @file    ${TM_FILENAME}",
      " * @brief   ${1:模块功能简述}",
      " * @author  ${2:作者}",
      " * @date    ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      " * @version ${3:v1.0}",
      " */",
      "$0"
    ],
    "description": "文件顶部模块说明块"
  },
  "函数头注释": {
    "scope": "c,cpp",
    "prefix": ["hdr", "函数头"],
    "body": [
      "/**",
      " * @brief  ${1:一句话说明函数做什么}",
      " *",
      " * @param  ${2:param} ${3:参数含义}",
      " * @return ${4:NONE / 返回值含义}",
      " *",
      " * @note   ${5:使用注意事项，无则删除本行}",
      " */",
      "$0"
    ],
    "description": "函数上方 Doxygen 说明块"
  },
  "分节分隔线": {
    "scope": "c,cpp",
    "prefix": ["sect", "分节"],
    "body": [
      "/* ==================== ${1:分区标题} ==================== */",
      "$0"
    ],
    "description": "把代码按功能分区，插入分隔线"
  },
  "批量包裹为注释框": {
    "scope": "c,cpp",
    "prefix": ["box", "框"],
    "body": [
      "/* ---------------------------------------------------------------",
      " * ${1:标题}",
      " * ---------------------------------------------------------------- */",
      "$TM_SELECTED_TEXT",
      "/* ---------------------------------------------------------------- */",
      "$0"
    ],
    "description": "选中若干行后使用，把整段内容包进带标题的注释框（批量）"
  },
  "批量行内注释": {
    "scope": "c,cpp",
    "prefix": ["blk", "批量注释"],
    "body": [
      "/* ${1:本段说明} */",
      "$TM_SELECTED_TEXT",
      "/* ${1:本段说明} 结束 */",
      "$0"
    ],
    "description": "选中若干行后使用，前后各加一条行内说明注释"
  },
  "TODO 标记": {
    "scope": "c,cpp",
    "prefix": ["todo", "fixme"],
    "body": [
      "/* TODO(${1:名字}): ${2:待办内容} */",
      "$0"
    ],
    "description": "插入 TODO 标记，会被问题面板收集"
  },
  "修改记录": {
    "scope": "c,cpp",
    "prefix": ["chg", "修改记录"],
    "body": [
      "/*",
      " * 修改记录:",
      " * ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}  ${1:名字}  ${2:改了什么}",
      " */",
      "$0"
    ],
    "description": "文件底部变更历史块"
  },
  "枚举/结构体说明": {
    "scope": "c,cpp",
    "prefix": ["defhdr", "结构体头"],
    "body": [
      "/**",
      " * @brief ${1:结构体/枚举用途}",
      " */",
      "$0"
    ],
    "description": "结构体、枚举、宏定义上方的说明"
  }
}
